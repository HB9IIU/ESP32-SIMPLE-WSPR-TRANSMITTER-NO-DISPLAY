#include <Arduino.h>
#include <Wire.h>
#include <si5351.h>
#include "driver/pcnt.h"

// ------- Pins -------
#define SI5351_SDA   25
#define SI5351_SCL   26
#define CLK1_PIN     34      // Si5351 CLK1 -> GPIO34 (input-only OK)
#define TP_PIN       27      // GPS timepulse at 100 Hz -> GPIO27

// ------- Config -------
static const uint32_t TARGET_HZ   = 3000000;   // your intended CLK1 frequency
static const uint32_t GATE_HZ     = 100;         // GPS timepulse rate (100 Hz => 10 ms window)
static const uint32_t WINDOW_GATES= 1000;        // average over N gates (1000 @100 Hz => 10 s)

static const bool     APPLY_CORR  = false;        // set false to just measure
static const long     STEP_CAP_PPB= 200000;     // cap each correction step (ppb)
static const long     LOCK_BAND   = 1000;       // skip applying when |err| <= LOCK_BAND (ppb)

// ------- Si5351 -------
Si5351 si5351;
static int32_t cal_factor_ppb = 0;
static const uint64_t CLK1_cHz = (uint64_t)TARGET_HZ * 100ULL;

// ------- PCNT -------
#define PCNT_UNIT_USED    PCNT_UNIT_0
#define PCNT_CHANNEL_USED PCNT_CHANNEL_0

volatile uint32_t last_count = 0;     // pulses in the last 10 ms gate
volatile bool     gate_ready = false;

// Simple PPS deglitch: ignore edges < 7 ms apart (expect 10 ms @ 100 Hz)
volatile uint64_t last_tp_us = 0;
static const uint32_t MIN_INTERVAL_US = 7000;

// -------- Helpers --------
static inline long compute_ppb_error(uint32_t measured_hz, uint32_t target_hz) {
  return lround(((double)measured_hz / (double)target_hz - 1.0) * 1e9);
}
static inline long clamp_long(long v, long lo, long hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

// -------- ISRs --------
void IRAM_ATTR tp_isr() {
  uint64_t now = esp_timer_get_time();
  if (now - last_tp_us < MIN_INTERVAL_US) return;  // drop spurious edge
  last_tp_us = now;

  int16_t c = 0;
  pcnt_get_counter_value(PCNT_UNIT_USED, &c);   // pulses since last gate
  pcnt_counter_clear(PCNT_UNIT_USED);           // start next 10 ms window
  last_count = (uint16_t)c;                     // ~counts_per_10ms
  gate_ready = true;
}

// -------- Init --------
static void initSI5351() {
  Wire.begin(SI5351_SDA, SI5351_SCL);
  Wire.setClock(400000);

  // probe (optional)
  Wire.beginTransmission(0x60);
  if (Wire.endTransmission() != 0) while (true) delay(1000);

  si5351.reset();
  si5351.init(SI5351_CRYSTAL_LOAD_8PF, 0, 0);
  si5351.set_correction(cal_factor_ppb, SI5351_PLL_INPUT_XO);

  // set CLK1 to TARGET_HZ and enable (others off)
  si5351.set_freq(CLK1_cHz, SI5351_CLK1);
   si5351.set_freq(1400000000ULL, SI5351_CLK1);
  si5351.drive_strength(SI5351_CLK1, SI5351_DRIVE_8MA);
    si5351.drive_strength(SI5351_CLK0, SI5351_DRIVE_8MA);
  si5351.set_clock_pwr(SI5351_CLK1, 1);
  si5351.set_clock_pwr(SI5351_CLK0, 1);
  si5351.set_clock_pwr(SI5351_CLK2, 0);
}

static void initPCNT() {
  pcnt_config_t cfg = {};
  cfg.pulse_gpio_num = CLK1_PIN;          // count Si5351 CLK1
  cfg.ctrl_gpio_num  = PCNT_PIN_NOT_USED;
  cfg.unit           = PCNT_UNIT_USED;
  cfg.channel        = PCNT_CHANNEL_USED;
  cfg.pos_mode       = PCNT_COUNT_INC;    // rising only
  cfg.neg_mode       = PCNT_COUNT_DIS;
  cfg.lctrl_mode     = PCNT_MODE_KEEP;
  cfg.hctrl_mode     = PCNT_MODE_KEEP;
  cfg.counter_l_lim  = 0;
  cfg.counter_h_lim  = 32767;             // never reached at 1–3 MHz with 10 ms gate

  pcnt_unit_config(&cfg);
  pcnt_filter_disable(PCNT_UNIT_USED);

  pcnt_counter_pause(PCNT_UNIT_USED);
  pcnt_counter_clear(PCNT_UNIT_USED);
  pcnt_counter_resume(PCNT_UNIT_USED);
}

void setup() {
  Serial.begin(115200);

  initSI5351();
  initPCNT();

  pinMode(TP_PIN, INPUT_PULLUP);  // use pull-up; many GPS timepulses are open-drain
  attachInterrupt(digitalPinToInterrupt(TP_PIN), tp_isr, RISING);
}

// -------- Accumulation & correction --------
void loop() {
  static uint64_t sum_counts = 0;   // total pulses across the window
  static uint32_t gates = 0;        // gates accumulated in the window

  if (!gate_ready) return;
  gate_ready = false;

  // accumulate one 10 ms measurement
  sum_counts += last_count;
  gates++;

  if (gates >= WINDOW_GATES) {
    // Average frequency: (sum_counts gates) * (gates_per_second) / (gates)
    // gates_per_second = GATE_HZ (100)
    uint64_t num = sum_counts * (uint64_t)GATE_HZ;
    uint32_t measured_hz = (uint32_t)((num + gates/2) / gates);  // rounded

    long err_ppb = compute_ppb_error(measured_hz, TARGET_HZ);

    // Print a single summary line per window
    // format: measured_Hz  err_ppb  corr_ppb
    Serial.print(measured_hz);
    Serial.print(' ');
    Serial.print(err_ppb);
    Serial.print(' ');
    Serial.println(cal_factor_ppb);

    // Optional: apply correction
    if (APPLY_CORR && labs(err_ppb) > LOCK_BAND) {
      long step = clamp_long(err_ppb, -STEP_CAP_PPB, +STEP_CAP_PPB);
      cal_factor_ppb += step;  // Etherkit semantics: +ppb lowers output
      si5351.set_correction(cal_factor_ppb, SI5351_PLL_INPUT_XO);
      si5351.set_freq(CLK1_cHz, SI5351_CLK1);    // re-apply so correction takes effect
    }

    // reset window
    sum_counts = 0;
    gates = 0;
  }
}
