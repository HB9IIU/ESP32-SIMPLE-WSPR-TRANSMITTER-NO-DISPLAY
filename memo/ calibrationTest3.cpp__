#include <Arduino.h>
#include <Wire.h>
#include "driver/pcnt.h"
#include <si5351.h>

#define SI5351_SDA 25
#define SI5351_SCL 26

// ---------------- Si5351 ----------------
Si5351 si5351;

// ---------------- Frequencies (Hz) ----------------
constexpr uint32_t CLK1_HZ = 10000;   // what PCNT measures (target) -> Si5351 CLK1
constexpr uint32_t CLK0_HZ = 14000000;   // optional WSPR/test on CLK0

// Library wants centi-Hz (Hz * 100)
constexpr uint64_t to_centi_hz(uint32_t hz) { return static_cast<uint64_t>(hz) * 100ULL; }
constexpr uint64_t CLK1_cHz = to_centi_hz(CLK1_HZ);
constexpr uint64_t CLK0_cHz = to_centi_hz(CLK0_HZ);
static int32_t cal_factor_ppb = 0;

// ----- Pins / PCNT selection -----
#define PPS_PIN         27        // GPS 1PPS -> GPIO27 (RISING edge)
#define PCNT_INPUT_PIN  32        // Signal to count -> GPIO32
#define PCNT_UNIT_USED  PCNT_UNIT_0
#define PCNT_CH_USED    PCNT_CHANNEL_0

// ----- Shared state (ISR <-> loop) -----
volatile uint64_t pcnt_base = 0;          // adds 32768 on every HLIM event
volatile bool     measuring_open = false;  // true between PPS edges (gate open)
volatile bool     measurement_ready = false;
volatile uint64_t last_count = 0;          // latched pulses-per-gate
volatile bool     armed = true;            // NEW: only measure when armed

// Make the snapshot atomic w.r.t. HLIM
portMUX_TYPE pcntMux = portMUX_INITIALIZER_UNLOCKED;

// ----- HLIM ISR: extend 16-bit counter -----
static void IRAM_ATTR pcnt_hlim_isr(void *arg) {
  portENTER_CRITICAL_ISR(&pcntMux);
  pcnt_base += 32768ULL;                  // we hit the high limit
  pcnt_counter_clear(PCNT_UNIT_USED);     // reset hardware counter to 0
  portEXIT_CRITICAL_ISR(&pcntMux);
}

// ----- PPS ISR: open/close the 1-second gate -----
static void IRAM_ATTR pps_isr() {
  if (!armed) return; // ignore PPS while sleeping / not armed

  int16_t hw_now = 0;
  portENTER_CRITICAL_ISR(&pcntMux);
  if (!measuring_open) {
    // Start counting from this PPS (open gate)
    pcnt_base = 0;
    pcnt_counter_clear(PCNT_UNIT_USED);
    measuring_open = true;
  } else {
    // Stop counting at this PPS (close gate)
    pcnt_get_counter_value(PCNT_UNIT_USED, &hw_now); // partial chunk 0..32767
    last_count = pcnt_base + (uint16_t)hw_now;       // total pulses in gate
    pcnt_base = 0;
    pcnt_counter_clear(PCNT_UNIT_USED);
    measuring_open = false;
    measurement_ready = true;                        // tell loop() to print
    armed = false;                                   // disarm until loop sleeps+re-arms
  }
  portEXIT_CRITICAL_ISR(&pcntMux);
}

// ----- PCNT setup: rising edges only, 0..32767 with HLIM event -----
void initPCNT() {
  pcnt_config_t pcfg = {};
  pcfg.pulse_gpio_num = PCNT_INPUT_PIN;
  pcfg.ctrl_gpio_num  = PCNT_PIN_NOT_USED;
  pcfg.unit           = PCNT_UNIT_USED;
  pcfg.channel        = PCNT_CH_USED;
  pcfg.pos_mode       = PCNT_COUNT_INC; // rising edges increment
  pcfg.neg_mode       = PCNT_COUNT_DIS; // ignore falling edges
  pcfg.lctrl_mode     = PCNT_MODE_KEEP; // control pin unused
  pcfg.hctrl_mode     = PCNT_MODE_KEEP;
  pcfg.counter_l_lim  = 0;
  pcfg.counter_h_lim  = 32767;

  if (pcnt_unit_config(&pcfg) != ESP_OK) {
    Serial.println("❌ pcnt_unit_config failed");
    while (true) delay(1000);
  }

  pcnt_filter_disable(PCNT_UNIT_USED);               // allow high rate
  pcnt_event_enable(PCNT_UNIT_USED, PCNT_EVT_H_LIM); // fire at 32767
  pcnt_counter_pause(PCNT_UNIT_USED);
  pcnt_counter_clear(PCNT_UNIT_USED);

  pcnt_isr_service_install(0);
  pcnt_isr_handler_add(PCNT_UNIT_USED, pcnt_hlim_isr, nullptr);

  pcnt_counter_resume(PCNT_UNIT_USED);
}

void initSI5351() {
  Serial.println("=== Initializing Si5351 ===");
  Wire.begin(SI5351_SDA, SI5351_SCL);
  Wire.setClock(400000);

  // Optional presence check
  Wire.beginTransmission(0x60);
  if (Wire.endTransmission() != 0) {
    Serial.println("❌ Si5351 not found at 0x60. Halting.");
    while (true) delay(1000);
  }

  si5351.reset();
  si5351.init(SI5351_CRYSTAL_LOAD_8PF, 0, 0);
  si5351.set_correction(cal_factor_ppb, SI5351_PLL_INPUT_XO);

  si5351.set_freq(CLK1_cHz, SI5351_CLK1);   // counter input
  si5351.set_freq(CLK0_cHz, SI5351_CLK0);   // optional test/WSPR
  si5351.drive_strength(SI5351_CLK1, SI5351_DRIVE_8MA);
  si5351.drive_strength(SI5351_CLK0, SI5351_DRIVE_8MA);

  // Turn on only what you need:
  si5351.set_clock_pwr(SI5351_CLK0, 1);     // keep CLK0 off by default
  si5351.set_clock_pwr(SI5351_CLK1, 1);     // enable CLK1 for counting
  Serial.println("=== Si5351 Initialization complete ===");
}



void setup() {
  Serial.begin(115200);
  delay(50);
  Serial.println("\nPPS-gated frequency counter (rising-to-next-rising, armed gating)");

  initSI5351();
  initPCNT();

  pinMode(PPS_PIN, INPUT); // use INPUT_PULLDOWN if your PPS is open-drain
  attachInterrupt(digitalPinToInterrupt(PPS_PIN), pps_isr, RISING);

  Serial.println("1) Waiting for PPS to OPEN the first gate...");
}

void loop() {
  if (measurement_ready) {
    uint64_t pulses;
    portENTER_CRITICAL(&pcntMux);
    pulses = last_count;
    measurement_ready = false;
    portEXIT_CRITICAL(&pcntMux);

    // Report
    Serial.print("Pulses in 1.000 s gate: ");
    Serial.print((uint32_t)pulses);
    // As Hz and ppb error
    double hz = (double)pulses;
    double ppb = ((hz / (double)CLK1_HZ) - 1.0) * 1e9;
    Serial.print("   (~");
    Serial.print((uint32_t)hz);
    Serial.print(" Hz, error ");
    Serial.print((int32_t)llround(ppb));
    Serial.println(" ppb)");

    // 5) wait 1500 ms (no measuring during this time, PPS ISR is disarmed)
    delay(1500);

    // 6) Start again at 1): arm and wait for PPS to open
    armed = true;
    Serial.println("1) Waiting for PPS to OPEN the next gate...");
  }
}
